# ============================================================================
# MemberAssist — environment template
# Copy to .env and fill in. NEVER commit .env.
# Model IDs are filled in automatically by:  uv run python manage.py check-models
# ============================================================================

# ---- LLM providers ---------------------------------------------------------
# Gemini   -> https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MAIN_MODEL=
GEMINI_LITE_MODEL=
# Groq     -> https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MAIN_MODEL=
GROQ_FAST_MODEL=
# OpenRouter (optional second fallback) -> https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Ollama (optional local privacy mode)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=
PRIVACY_MODE=false
MAIN_LLM_ORDER=gemini,groq,openrouter
AUX_LLM_ORDER=groq_fast,gemini_lite

# ---- Health data APIs ------------------------------------------------------
# CMS Marketplace -> https://developer.cms.gov/marketplace-api (keys expire every 60 days)
CMS_MARKETPLACE_API_KEY=
# openFDA (optional, raises rate limit) -> https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=
# Sent as a User-Agent contact on public API calls (NLM/CMS etiquette)
CONTACT_EMAIL=
PLAN_STATE=TX
PLAN_COUNTY_FIPS=48113
PLAN_YEAR=2026

# ---- App security ----------------------------------------------------------
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
RATE_LIMIT_PER_MINUTE=20
ALLOWED_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql+psycopg://memberassist:CHANGE_ME@localhost:5432/memberassist
POSTGRES_PASSWORD=CHANGE_ME
DEMO_PASSWORD=

# ---- Safety text (region-specific) ----------------------------------------
EMERGENCY_TEXT=If this is an emergency, call 911 (US) or 112 (India), or go to the nearest emergency department now.
CRISIS_TEXT=You don't have to go through this alone. In the US call or text 988; in India call Tele-MANAS at 14416.

# ---- Privacy / telemetry ---------------------------------------------------
HF_HUB_DISABLE_TELEMETRY=1
ANONYMIZED_TELEMETRY=False
