# ---- secrets ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
uv.lock.bak

# ---- node / frontend ----
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# ---- data: raw downloads, indexes, caches, uploads (never committed) ----
data/raw/
data/index/
data/cache/
data/uploads/
data/samples/*.bin
# Fetched knowledge-base documents are downloads, whatever their format: the
# manifest records what was fetched, with a hash, so the files themselves never
# need committing. Documents we author ourselves are kept.
data/kb/files/
data/kb/**/*.pdf
!data/kb/manifest.yaml
!data/kb/authored/
data/synthetic/*.csv
!data/synthetic/.gitkeep

# ---- models / weights ----
models/
*.onnx
*.gguf
*.safetensors
*.bin
.cache/
hf_cache/

# ---- eval outputs (keep small reports, drop bulk) ----
eval/results/*.json
!eval/results/.gitkeep

# ---- os / editor ----
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/settings.json.example

# ---- logs ----
*.log
logs/

# ---- local db fallback ----
*.sqlite3
*.db

# ---- teammate drop-box ----
# Files arrive here and are then moved into their real homes (eval/, docs/,
# data/kb/authored/). Keeping the originals as well would mean two copies of
# the same test data drifting apart. docs/evaluation.md records every change
# made to a supplied file, so the originals are not needed in git.
team_inputs/
